{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "outDir": "./build",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*.mts"
  ]
}
